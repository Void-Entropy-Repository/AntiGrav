pkgname=antigravity-ide
version=2.0.1
revision=1
archs="x86_64"
depends="libX11 libxcb libXcomposite libXcursor libXdamage libXext libXfixes libXi libXrender libXtst nss alsa-lib pango at-spi2-core libcups"
short_desc="Google Anti-Gravity IDE"
maintainer="Shehata <shehataofficialmail@gmail.com>"
license="custom:Proprietary"
homepage="https://antigravity.google"
distfiles="https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/${version}-4861014005645312/linux-x64/Antigravity%20IDE.tar.gz>antigravity-ide-${version}.tar.gz https://raw.githubusercontent.com/Void-Entropy-Repository/AntiGrav/main/assets/icon.png>antigravity-ide.png"
checksum="747163aa3a8afba4b316f97c40b4a75ca4736a59768a416cd1e881e73ec31ef9 b27f0e4a6f14f491ba31bb24533a1f43c677362b12a0744a53fdd09d7c785317"
skip_extraction="antigravity-ide.png"
repository=nonfree
restricted=yes
nostrip=yes

do_install() {
	local opt_path="opt/antigravity-ide"
	vmkdir "${opt_path}"
	vcopy * "${opt_path}/"
	rm -f ${DESTDIR}/${opt_path}/antigravity-ide.png

	vmkdir usr/bin
	cat <<EOF > ${DESTDIR}/usr/bin/antigravity
#!/bin/sh
exec /opt/antigravity-ide/antigravity-ide "\$@"
EOF
	chmod +x ${DESTDIR}/usr/bin/antigravity

	vmkdir usr/share/applications
	cat <<EOF > ${DESTDIR}/usr/share/applications/antigravity-ide.desktop
[Desktop Entry]
Name=Antigravity IDE
Comment=Google Antigravity Agentic IDE
Exec=/usr/bin/antigravity-ide %U
Icon=antigravity-ide
Type=Application
Terminal=false
Categories=Development;IDE;
StartupWMClass=antigravity
EOF

	vinstall ${XBPS_SRCDISTDIR}/${pkgname}-${version}/antigravity-ide.png 644 usr/share/pixmaps antigravity-ide.png
}
