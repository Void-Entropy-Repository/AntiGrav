# Template file for 'antigravity'
pkgname=antigravity
version=1.23.2
revision=1
archs="x86_64"
depends="libX11 libxcb libXcomposite libXcursor libXdamage libXext libXfixes libXi libXrender libXtst nss alsa-lib pango at-spi2-core libcups"
short_desc="Google Anti-Gravity IDE"
maintainer="Shehata <shehataofficialmail@gmail.com>"
license="custom:Proprietary"
homepage="https://antigravity.google"
distfiles="https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/${version}-4781536860569600/linux-x64/Antigravity.tar.gz"
checksum="5232a4048ff4fa15685d9a981ba4fba573e297f3efc9b76f638e794baf775725"

repository=nonfree
restricted=yes
nostrip=yes

do_install() {
	local opt_path="opt/antigravity"
	vmkdir "${opt_path}"
	vcopy * "${opt_path}/"

	vmkdir usr/bin
	cat <<EOF > ${DESTDIR}/usr/bin/antigravity
#!/bin/sh
exec /opt/antigravity/antigravity "\$@"
EOF
	chmod +x ${DESTDIR}/usr/bin/antigravity

	# Generate the missing .desktop file
	vmkdir usr/share/applications
	cat <<EOF > ${DESTDIR}/usr/share/applications/antigravity.desktop
[Desktop Entry]
Name=AntiGravity
Comment=Google Anti-Gravity IDE
Exec=/usr/bin/antigravity %U
Icon=antigravity
Type=Application
Terminal=false
Categories=Development;IDE;
StartupWMClass=antigravity
EOF

	# Extract and install the icon found in fzf search
	vinstall resources/app/out/vs/workbench/contrib/antigravityCustomAppIcon/browser/media/antigravity/antigravity.png 644 usr/share/pixmaps antigravity.png
}
